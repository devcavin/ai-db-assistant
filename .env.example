# Copy to .env and replace every CHANGE_ME value.
# Required: DATABASE_URL, JWT_SECRET (the server refuses to start without them).

PORT=8080
ENVIRONMENT=development

DB_USER=postgres
DB_PASSWORD=CHANGE_ME_db_password
DATABASE_URL=postgresql://postgres:CHANGE_ME_db_password@localhost:5432/ai_db_assistant?sslmode=disable

# At least 32 characters. Generate one with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRY=24h

PROXY_SERVER_URL=http://localhost:8000